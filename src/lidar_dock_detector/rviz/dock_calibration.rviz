Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Pose1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 832
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: LaserScan
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MarkerArray
      Namespaces:
        accepted_dock_pose: true
        accepted_marker_pose: true
        accepted_model_lines: true
        detector_state: true
        filtered_dock_pose: true
        filtered_model_lines: true
        fitted_lines: true
        marker_frame: true
        rejected_candidate_labels: true
        rejected_candidates: true
        rejected_line_labels: true
        rejected_line_segments: true
        residual_peaks: true
        roi_points: true
        split_points: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /dock_detector/debug_markers
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.10000000149011612
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.05000000074505806
      Head Radius: 0.050999999046325684
      Name: Pose
      Shaft Length: 0.25
      Shaft Radius: 0.05000000074505806
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /detected_dock_pose
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 47
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: LaserScan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: false
        base_scan:
          Value: true
        camera_link:
          Value: false
        d430i_aligned_depth_to_infra1_frame:
          Value: false
        d430i_depth_frame:
          Value: false
        d430i_depth_optical_frame:
          Value: false
        d430i_infra1_frame:
          Value: false
        d430i_infra1_optical_frame:
          Value: false
        d430i_link:
          Value: false
        dock_marker:
          Value: true
        fake_app_lock_scan:
          Value: false
        fake_sick_lock_scan:
          Value: false
        imu_link:
          Value: false
        left_caster_ball_back:
          Value: false
        left_caster_ball_front:
          Value: false
        left_wheel:
          Value: false
        map:
          Value: true
        odom:
          Value: false
        right_caster_ball_back:
          Value: false
        right_caster_ball_front:
          Value: false
        right_wheel:
          Value: false
        us1_scan:
          Value: false
        us2_scan:
          Value: false
        us3_scan:
          Value: false
        us4_scan:
          Value: false
        usb_cam_link:
          Value: false
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        map:
          {}
        odom:
          base_link:
            base_scan:
              {}
            camera_link:
              {}
            fake_app_lock_scan:
              {}
            fake_sick_lock_scan:
              {}
            imu_link:
              {}
            left_caster_ball_back:
              {}
            left_caster_ball_front:
              {}
            left_wheel:
              {}
            right_caster_ball_back:
              {}
            right_caster_ball_front:
              {}
            right_wheel:
              {}
            us1_scan:
              {}
            us2_scan:
              {}
            us3_scan:
              {}
            us4_scan:
              {}
            usb_cam_link:
              {}
          dock_marker:
            {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_scan
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.078089475631714
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.021189093589782715
        Y: -0.20853552222251892
        Z: 0.15604038536548615
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.7903978228569031
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 4.120397567749023
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1129
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 23
